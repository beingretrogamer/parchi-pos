{
  "version": 2,
  "about": "billTotals(lines, discount, pricesIncludeTax, serviceChargePct = 0). Amounts in paise. The discount is spread over lines in proportion, the remainder on the last line; tax is per line at its own rate, rounded half away from zero (Math.round). A service charge is pct of each line’s value before tax (rounded per line) and is taxed at that line’s rate; serviceCharge is its sum before tax and serviceChargeTax the tax on it; tax and lines[].tax include that tax.",
  "cases": [
    {
      "name": "no tax, no discount",
      "lines": [
        {
          "price": 4000,
          "qty": 2
        },
        {
          "price": 6000,
          "qty": 1
        }
      ],
      "discount": 0,
      "pricesIncludeTax": true,
      "expected": {
        "subtotal": 14000,
        "discount": 0,
        "serviceCharge": 0,
        "serviceChargeTax": 0,
        "tax": 0,
        "total": 14000,
        "lines": [
          {
            "net": 8000,
            "tax": 0
          },
          {
            "net": 6000,
            "tax": 0
          }
        ]
      }
    },
    {
      "name": "5% inclusive with a discount",
      "lines": [
        {
          "price": 10500,
          "qty": 1,
          "taxRate": 5
        },
        {
          "price": 5250,
          "qty": 2,
          "taxRate": 5
        }
      ],
      "discount": 2100,
      "pricesIncludeTax": true,
      "expected": {
        "subtotal": 21000,
        "discount": 2100,
        "serviceCharge": 0,
        "serviceChargeTax": 0,
        "tax": 900,
        "total": 18900,
        "lines": [
          {
            "net": 9450,
            "tax": 450
          },
          {
            "net": 9450,
            "tax": 450
          }
        ]
      }
    },
    {
      "name": "discount remainder lands on the last line",
      "lines": [
        {
          "price": 1000,
          "qty": 1
        },
        {
          "price": 1000,
          "qty": 1
        },
        {
          "price": 1000,
          "qty": 1
        }
      ],
      "discount": 100,
      "pricesIncludeTax": true,
      "expected": {
        "subtotal": 3000,
        "discount": 100,
        "serviceCharge": 0,
        "serviceChargeTax": 0,
        "tax": 0,
        "total": 2900,
        "lines": [
          {
            "net": 967,
            "tax": 0
          },
          {
            "net": 967,
            "tax": 0
          },
          {
            "net": 966,
            "tax": 0
          }
        ]
      }
    },
    {
      "name": "exclusive prices add the tax",
      "lines": [
        {
          "price": 10000,
          "qty": 1,
          "taxRate": 5
        }
      ],
      "discount": 0,
      "pricesIncludeTax": false,
      "expected": {
        "subtotal": 10000,
        "discount": 0,
        "serviceCharge": 0,
        "serviceChargeTax": 0,
        "tax": 500,
        "total": 10500,
        "lines": [
          {
            "net": 10000,
            "tax": 500
          }
        ]
      }
    },
    {
      "name": "a discount above the subtotal is capped",
      "lines": [
        {
          "price": 5000,
          "qty": 1
        }
      ],
      "discount": 9000,
      "pricesIncludeTax": true,
      "expected": {
        "subtotal": 5000,
        "discount": 5000,
        "serviceCharge": 0,
        "serviceChargeTax": 0,
        "tax": 0,
        "total": 0,
        "lines": [
          {
            "net": 0,
            "tax": 0
          }
        ]
      }
    },
    {
      "name": "service charge 5% on a 5% inclusive line: the charge carries the line’s GST",
      "lines": [
        {
          "price": 10000,
          "qty": 1,
          "taxRate": 5
        }
      ],
      "discount": 0,
      "pricesIncludeTax": true,
      "serviceChargePct": 5,
      "expected": {
        "subtotal": 10000,
        "discount": 0,
        "serviceCharge": 476,
        "serviceChargeTax": 24,
        "tax": 500,
        "total": 10500,
        "lines": [
          {
            "net": 10000,
            "tax": 500
          }
        ]
      }
    },
    {
      "name": "service charge 10%, exclusive, two rates, after a discount",
      "lines": [
        {
          "price": 4000,
          "qty": 2,
          "taxRate": 5
        },
        {
          "price": 6000,
          "qty": 1,
          "taxRate": 12
        }
      ],
      "discount": 1000,
      "pricesIncludeTax": false,
      "serviceChargePct": 10,
      "expected": {
        "subtotal": 14000,
        "discount": 1000,
        "serviceCharge": 1300,
        "serviceChargeTax": 104,
        "tax": 1144,
        "total": 15444,
        "lines": [
          {
            "net": 7429,
            "tax": 408
          },
          {
            "net": 5571,
            "tax": 736
          }
        ]
      }
    },
    {
      "name": "service charge on an untaxed line rounds half up",
      "lines": [
        {
          "price": 4550,
          "qty": 3
        }
      ],
      "discount": 0,
      "pricesIncludeTax": true,
      "serviceChargePct": 5,
      "expected": {
        "subtotal": 13650,
        "discount": 0,
        "serviceCharge": 683,
        "serviceChargeTax": 0,
        "tax": 0,
        "total": 14333,
        "lines": [
          {
            "net": 13650,
            "tax": 0
          }
        ]
      }
    }
  ]
}
