<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog is a sheet laid on the paper: inset so the window keeps its margins. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/card" />
        <corners android:radius="8dp" />
        <stroke android:width="1dp" android:color="@color/line" />
    </shape>
</inset>
