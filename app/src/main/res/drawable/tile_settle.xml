<?xml version="1.0" encoding="utf-8"?>
<!-- A table whose bill is printed and waits to be settled: amber, like "wait" in the portal. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/warn_soft" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/warn" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/warn_soft" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="@color/warn" />
        </shape>
    </item>
</selector>
