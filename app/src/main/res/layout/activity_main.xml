<?xml version="1.0" encoding="utf-8"?>
<!--
    The till. Menu tiles fill the screen; the cart sits under them and only
    appears once something is in it, so a phone screen is not half cart before
    the first tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/side_padding"
        android:tag="sidePad"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSales"
            style="@style/TopButton"
            android:text="@string/btn_sales" />

        <Button
            android:id="@+id/btnMenu"
            style="@style/TopButton"
            android:text="@string/btn_menu" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:contentDescription="@string/title_settings"
            android:text="@string/btn_settings_icon" />
    </LinearLayout>

    <!-- Search, and the way to ring up something that is not on the menu. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/side_padding"
        android:tag="sidePad"
        android:paddingEnd="@dimen/side_padding"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/search"
            style="@style/Field"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="@string/hint_search"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/btnCustom"
            style="@style/TopButton"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/btn_custom"
            android:textColor="@color/accent"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/categoryBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/side_padding"
            android:tag="sidePad"
            android:paddingEnd="@dimen/side_padding"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/side_padding"
            android:tag="sidePad"
            android:paddingEnd="@dimen/side_padding"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/itemGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/emptyMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_menu"
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAddItems"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_primary"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_add_items"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ── Cart ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/cartCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cart_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:tag="sidePad"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cartTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink_soft"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/row_bg_plain"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/btn_clear"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/cartScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/cartLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <EditText
            android:id="@+id/customer"
            style="@style/Field"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_customer"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/payCash"
                style="@style/PayButton"
                android:text="@string/pay_cash" />

            <Button
                android:id="@+id/payUpi"
                style="@style/PayButton"
                android:layout_marginStart="8dp"
                android:text="@string/pay_upi" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/btn_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/btn_save_only"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCharge"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
