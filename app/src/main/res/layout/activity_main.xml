<?xml version="1.0" encoding="utf-8"?>
<!--
    The till. Menu tiles fill the screen; the cart sits under them and only
    appears once something is in it, so a phone screen is not half cart before
    the first tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/side_padding"
        android:tag="sidePad"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- The shop's name, and under it whether this device is live, waiting or offline. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <!-- Parchi Cloud: "● Live · Galla", "● 3 waiting", "● Offline"; tap for details. -->
            <TextView
                android:id="@+id/cloudDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingTop="1dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Manager: a padlock when locked, the name and time left when a PIN has unlocked it. -->
        <TextView
            android:id="@+id/managerChip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="36dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:maxWidth="132dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Shown when the outlet has tables (Parchi Cloud): the tables grid. -->
        <!-- Icons on a phone; icon and word where there is room (MainActivity.renderNav). -->
        <Button
            android:id="@+id/btnTables"
            style="@style/NavButton"
            android:contentDescription="@string/btn_tables"
            android:drawableStart="@drawable/ic_nav_tables"
            android:drawableTint="@color/accent"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSales"
            style="@style/NavButton"
            android:contentDescription="@string/btn_sales"
            android:drawableStart="@drawable/ic_nav_sales" />

        <Button
            android:id="@+id/btnLedger"
            style="@style/NavButton"
            android:contentDescription="@string/btn_ledger"
            android:drawableStart="@drawable/ic_nav_dues" />

        <Button
            android:id="@+id/btnMenu"
            style="@style/NavButton"
            android:contentDescription="@string/btn_menu"
            android:drawableStart="@drawable/ic_nav_menu" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/NavButton"
            android:contentDescription="@string/title_settings"
            android:drawableStart="@drawable/ic_nav_settings" />
    </LinearLayout>

    <!-- Table mode: which table this round is for, back to the tables, and its order so far. -->
    <LinearLayout
        android:id="@+id/tableBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/accent_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:tag="sidePad"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBackToTables"
            style="@style/TopButton"
            android:layout_marginStart="0dp"
            android:text="@string/btn_back_tables" />

        <TextView
            android:id="@+id/tableTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOrder"
            style="@style/TopButton"
            android:text="@string/btn_order" />
    </LinearLayout>

    <!--
        The menu and the order: stacked on a phone (the order docked under the
        menu once something is in it), side by side on a tablet or an open Fold.
        MainActivity.layoutBody switches between the two.
    -->
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/menuPane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- Search, and the way to ring up something that is not on the menu. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/side_padding"
        android:tag="sidePad"
        android:paddingEnd="@dimen/side_padding"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/search"
            style="@style/Field"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="@string/hint_search"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/btnCustom"
            style="@style/TopButton"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/btn_custom"
            android:textColor="@color/accent"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadingEdgeLength="28dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/categoryBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/side_padding"
            android:tag="sidePad"
            android:paddingEnd="@dimen/side_padding"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/gridScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/side_padding"
            android:tag="sidePad"
            android:paddingEnd="@dimen/side_padding"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/itemGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/emptyMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_menu"
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAddItems"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_primary"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/btn_add_items"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

        <!-- In "All": the heading of the category scrolled to, held at the top. -->
        <TextView
            android:id="@+id/stickyHead"
            style="@style/GridHeading"
            android:layout_width="match_parent"
            android:background="@color/bg"
            android:paddingStart="@dimen/side_padding"
            android:paddingEnd="@dimen/side_padding"
            android:tag="sidePad"
            android:visibility="gone" />
    </FrameLayout>
    </LinearLayout>

    <!-- ── Cart ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/cartCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/cart_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:tag="sidePad"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cartTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/plex_mono"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDiscount"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/row_bg_plain"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_discount"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBillDay"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/row_bg_plain"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/row_bg_plain"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/btn_clear"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/cartEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingBottom="48dp"
            android:text="@string/cart_empty_hint"
            android:textColor="@color/ink_faint"
            android:textSize="15sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/cartScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/cartLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/discountLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Suggests customers who already have a credit account, so one person is not two accounts. -->
        <AutoCompleteTextView
            android:id="@+id/customer"
            style="@style/Field"
            android:layout_marginTop="8dp"
            android:completionThreshold="1"
            android:hint="@string/hint_customer"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/payCash"
                style="@style/PayButton"
                android:text="@string/pay_cash" />

            <Button
                android:id="@+id/payUpi"
                style="@style/PayButton"
                android:layout_marginStart="8dp"
                android:text="@string/pay_upi" />

            <Button
                android:id="@+id/payCredit"
                style="@style/PayButton"
                android:layout_marginStart="8dp"
                android:text="@string/pay_credit" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/btn_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/btn_save_only"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCharge"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
