<?xml version="1.0" encoding="utf-8"?>
<!--
    Credit (udhaar) accounts. Without a customer extra it lists every account
    with what they owe; with one, it is that customer's statement.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/ledgerTitle"
            style="@style/PageTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/ledgerTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ledgerSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <!-- Statement only. -->
            <LinearLayout
                android:id="@+id/ledgerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnReceive"
                    style="@style/PayButton"
                    android:background="@drawable/btn_primary"
                    android:text="@string/btn_receive"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnShareStatement"
                    style="@style/PayButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_share_statement" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/ledgerSection"
                style="@style/SectionLabel" />

            <TextView
                android:id="@+id/ledgerEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_faint"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ledgerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
