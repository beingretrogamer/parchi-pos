<?xml version="1.0" encoding="utf-8"?>
<!-- A discount on the whole bill being rung up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <RadioGroup
        android:id="@+id/discKind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/discPercent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/disc_percent"
            android:textColor="@color/ink" />

        <RadioButton
            android:id="@+id/discRupees"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/disc_rupees"
            android:textColor="@color/ink" />
    </RadioGroup>

    <EditText
        android:id="@+id/discValue"
        style="@style/Field"
        android:layout_marginTop="8dp"
        android:importantForAutofill="no"
        android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/discPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <TextView style="@style/FieldLabel" android:text="@string/label_disc_reason" />

    <EditText
        android:id="@+id/discReason"
        style="@style/Field"
        android:hint="@string/hint_disc_reason"
        android:importantForAutofill="no"
        android:inputType="textCapSentences" />
</LinearLayout>
