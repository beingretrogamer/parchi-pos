<?xml version="1.0" encoding="utf-8"?>
<!-- Editing one line of the bill being rung up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <TextView style="@style/FieldLabel" android:text="@string/label_item_name" />

    <EditText
        android:id="@+id/lineName"
        style="@style/Field"
        android:importantForAutofill="no"
        android:inputType="textCapWords" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FieldLabel" android:text="@string/label_rate" />

            <EditText
                android:id="@+id/linePrice"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FieldLabel" android:text="@string/label_qty" />

            <EditText
                android:id="@+id/lineQty"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

    <TextView style="@style/FieldLabel" android:text="@string/label_note" />

    <EditText
        android:id="@+id/lineNote"
        style="@style/Field"
        android:hint="@string/hint_note"
        android:importantForAutofill="no"
        android:inputType="textCapSentences" />

    <!-- Custom items only: keep it on the menu so it is one tap next time. -->
    <LinearLayout
        android:id="@+id/saveBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/lineSaveToMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_save_to_menu"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <AutoCompleteTextView
            android:id="@+id/lineCategory"
            style="@style/Field"
            android:layout_marginTop="6dp"
            android:completionThreshold="1"
            android:hint="@string/hint_menu_category"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
