<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/PageTitle"
            android:text="@string/title_settings" />

        <!-- ── Printer ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_printer" />

            <TextView style="@style/FieldLabel" android:text="@string/label_printer_ip" />

            <EditText
                android:id="@+id/printerIp"
                style="@style/Field"
                android:hint="192.168.1.200"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView style="@style/FieldLabel" android:text="@string/label_printer_port" />

            <EditText
                android:id="@+id/printerPort"
                style="@style/Field"
                android:hint="9100"
                android:importantForAutofill="no"
                android:inputType="number" />

            <TextView style="@style/FieldLabel" android:text="@string/label_paper" />

            <RadioGroup
                android:id="@+id/paper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/paper80"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/paper_80"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/paper58"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/paper_58"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/printParchi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="44dp"
                android:text="@string/label_print_parchi"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_test"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hint_test"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ── What the bill says ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_bill" />

            <TextView style="@style/FieldLabel" android:text="@string/label_shop_name" />
            <EditText
                android:id="@+id/shopName"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textCapWords" />

            <TextView style="@style/FieldLabel" android:text="@string/label_address" />
            <EditText
                android:id="@+id/address"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress|textCapWords" />

            <TextView style="@style/FieldLabel" android:text="@string/label_phone" />
            <EditText
                android:id="@+id/phone"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="phone" />

            <TextView style="@style/FieldLabel" android:text="@string/label_gstin" />
            <EditText
                android:id="@+id/gstin"
                style="@style/Field"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters" />

            <TextView style="@style/FieldLabel" android:text="@string/label_footer" />
            <EditText
                android:id="@+id/footer"
                style="@style/Field"
                android:hint="@string/hint_footer"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ── Activity ───────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/label_activity" />

            <TextView
                android:id="@+id/logView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="40"
                android:textColor="@color/ink_soft"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_copy_log"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_secondary"
            android:text="@string/btn_check_update"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
