<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/side_padding"
        android:paddingEnd="@dimen/side_padding"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView style="@style/PageTitle" android:text="@string/title_cloud" />

        <!-- ── Not connected: connect with a code ─────────────── -->
        <LinearLayout
            android:id="@+id/connectCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_connect" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cloud_intro"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView style="@style/FieldLabel" android:text="@string/label_code" />
            <EditText
                android:id="@+id/code"
                style="@style/Field"
                android:hint="@string/hint_code"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                android:maxLength="9"
                android:textSize="20sp"
                android:fontFamily="@font/plex_mono" />

            <TextView style="@style/FieldLabel" android:text="@string/label_phone_name" />
            <EditText
                android:id="@+id/deviceName"
                style="@style/Field"
                android:hint="@string/hint_phone_name"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="40" />

            <TextView
                android:id="@+id/uploadNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_primary"
                android:text="@string/btn_connect"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/serverLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ink_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ── Connected: status ──────────────────────────────── -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_this_phone" />

            <TextView
                android:id="@+id/stateLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stateDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSyncNow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_sync_now"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ── First connection: menu and bill header ─────────── -->
        <LinearLayout
            android:id="@+id/choiceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_choices" />
            <LinearLayout
                android:id="@+id/choiceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ── Phones of this outlet ──────────────────────────── -->
        <LinearLayout
            android:id="@+id/phonesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_phones" />
            <TextView
                android:id="@+id/phonesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ── What the server refused ────────────────────────── -->
        <LinearLayout
            android:id="@+id/problemsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SectionLabel" android:text="@string/section_problems" />
            <TextView
                android:id="@+id/problemsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/danger"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRetryRejected"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_secondary"
                android:text="@string/btn_retry_rejected"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_secondary"
            android:text="@string/btn_disconnect"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
