<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the page carries its own title, and a stock light bar
         above a dark-mode page looks like a bug. -->
    <!--
      The look is Parchi Cloud's (paper, ink, one blue stamp; Instrument Sans,
      Fraunces for titles, IBM Plex Mono for labels). Parchi.Base is the only
      part that differs by night mode (values-night), so everything else is
      written once, here. Fonts are res/font; on Android 7 (before font
      resources) the system font stands in.
    -->
    <style name="Parchi.Base" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
    <style name="Parchi.DialogBase" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert" />

    <style name="AppTheme" parent="Parchi.Base">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/ink_faint</item>
        <item name="android:colorControlHighlight">@color/accent_soft</item>
        <item name="android:textColorHighlight">@color/accent_soft</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:textColorHint">@color/ink_hint</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:alertDialogTheme">@style/Parchi.Dialog</item>
    </style>

    <!-- Dialogs on a sheet of the same paper, with blue actions in the text face. -->
    <style name="Parchi.Dialog" parent="Parchi.DialogBase">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/ink_faint</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:textColorHint">@color/ink_hint</item>
        <item name="android:textColorAlertDialogListItem">@color/ink</item>
        <item name="android:buttonBarButtonStyle">@style/Parchi.DialogButton</item>
    </style>

    <style name="Parchi.DialogButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small uppercase heading that separates a card into a named section. -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/plex_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- 48dp tall: these get typed on with a thumb, standing at a counter. -->
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="PageTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Compact header action: Sales, Menu, settings. -->
    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Equal-width buttons sharing a row. -->
    <style name="PayButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
