<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The printer is a raw socket on the LAN; the update check is HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Bluetooth printers, paired in Android's settings. Android 12+ asks for
        "Nearby devices" (BLUETOOTH_CONNECT) at the moment one is chosen; older
        phones grant the old permissions at install. No scanning, no location.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Not required: Wi-Fi printers work on a phone without Bluetooth. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- ParchiApp keeps Parchi Cloud sync going while the app is in use. -->
    <application
        android:name=".ParchiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--
            configChanges: a rotation would otherwise rebuild the activity and
            empty the cart mid-order. The screen reflows its grid itself.
            adjustResize keeps the Print button above the keyboard while a
            customer name is typed.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:label="@string/title_menu" />

        <activity
            android:name=".SalesActivity"
            android:exported="false"
            android:label="@string/title_sales" />

        <activity
            android:name=".LedgerActivity"
            android:exported="false"
            android:label="@string/title_ledger" />

        <activity
            android:name=".CloudActivity"
            android:exported="false"
            android:label="@string/title_cloud"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Sends waiting bills when the phone gets network, with the app closed. -->
        <service
            android:name=".SyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:windowSoftInputMode="adjustResize|stateHidden" />
    </application>
</manifest>
